// Portable host settings. Device names, indexes and paths stay local.
// HOSTCFG(key, type, preference, default_priority)
HOSTCFG("middle_mouse", mouse, input_mouse_untrap, 0)
HOSTCFG("active_priority", priority, win32_active_capture_priority, 1)
HOSTCFG("active_not_captured_nosound", boolean, win32_active_nocapture_nosound, 0)
HOSTCFG("active_not_captured_pause", boolean, win32_active_nocapture_pause, 0)
HOSTCFG("active_input", activity, win32_active_input, 0)
HOSTCFG("inactive_priority", priority, win32_inactive_priority, 1)
HOSTCFG("inactive_nosound", boolean, win32_inactive_nosound, 0)
HOSTCFG("inactive_pause", boolean, win32_inactive_pause, 0)
HOSTCFG("inactive_input", activity, win32_inactive_input, 0)
HOSTCFG("iconified_priority", priority, win32_iconified_priority, 2)
HOSTCFG("iconified_nosound", boolean, win32_iconified_nosound, 0)
HOSTCFG("iconified_pause", boolean, win32_iconified_pause, 0)
HOSTCFG("iconified_input", activity, win32_iconified_input, 0)
HOSTCFG("uaescsimode", scsi, win32_uaescsimode, 0)
HOSTCFG("rtg_vblank", vblank, win32_rtgvblankrate, 0)
HOSTCFG("recording_width", integer, aviout_width, 0)
HOSTCFG("recording_height", integer, aviout_height, 0)
HOSTCFG("recording_x", integer, aviout_xoffset, 0)
HOSTCFG("recording_y", integer, aviout_yoffset, 0)
HOSTCFG("screenshot_width", integer, screenshot_width, 0)
HOSTCFG("screenshot_height", integer, screenshot_height, 0)
HOSTCFG("screenshot_x", integer, screenshot_xoffset, 0)
HOSTCFG("screenshot_y", integer, screenshot_yoffset, 0)
HOSTCFG("screenshot_min_width", integer, screenshot_min_width, 0)
HOSTCFG("screenshot_min_height", integer, screenshot_min_height, 0)
HOSTCFG("screenshot_max_width", integer, screenshot_max_width, 0)
HOSTCFG("screenshot_max_height", integer, screenshot_max_height, 0)
HOSTCFG("screenshot_output_width_limit", integer, screenshot_output_width, 0)
HOSTCFG("screenshot_output_height_limit", integer, screenshot_output_height, 0)
HOSTCFG("screenshot_mult_width", multiplier, screenshot_xmult, 0)
HOSTCFG("screenshot_mult_height", multiplier, screenshot_ymult, 0)
HOSTCFG("cpu_idle", integer, cpu_idle, 0)
